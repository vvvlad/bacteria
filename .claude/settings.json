{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/vvetshte/.local/bin/tokensave",
            "args": [
              "hook-pre-tool-use"
            ]
          }
        ],
        "matcher": "Agent|Grep|Bash"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/vvetshte/.local/bin/tokensave",
            "args": [
              "hook-prompt-submit"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/vvetshte/.local/bin/tokensave",
            "args": [
              "hook-stop"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.stdout.write(JSON.stringify({hookSpecificOutput:{hookEventName:'SessionStart',additionalContext:Buffer.from('','base64').toString('utf-8')}}))\"",
            "_managedBy": "aisg-dev-tools"
          }
        ]
      }
    ]
  },
